{application, hecate_biotope, [
    {description, "One island: an open population of creatures, their organs, and the energy economy that decides who breeds"},
    {vsn, "0.1.0"},
    {registered, [hecate_biotope_sup, world_server]},
    {mod, {hecate_biotope_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% ⚠ FOR THE NARRATOR AND NOTHING ELSE. An island with no model to ask
        %% never opens a socket, but a release that cannot has no way to say so.
        inets,
        ssl,
        %% Mesh SDK, realm identity, capabilities, health.
        hecate_om
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/hecate-services/hecate-biotope"}]}
]}.
