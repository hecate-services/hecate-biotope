%% -*- mode: erlang -*-
%% rebar3 configuration for hecate_biotope.
%%
%% THIS EXISTS SO CREATURES CAN LIVE, EAT, BREED AND DIE ON A NODE YOU DO NOT OWN.
%%
%% A biotope is one island: a bounded world with its own local conditions, an
%% open population of creatures whose bodies are made of organs, and an energy
%% economy that decides which of them get to reproduce. One biotope per node.
%% Islands meet by exchanging migrants over the mesh, later.
%%
%% SCAFFOLD. The service boots, answers health, and holds no world yet. That is
%% deliberate: the release, the image, the CI and the deployment are the part
%% that is tedious to retrofit, and the world is the part that is interesting to
%% build. This end is done first so the other end is never blocked on it.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) and the whole reckon-db stack transitively.
    %%
    %% ⚠ AND THAT COMMENT USED TO BE WRONG. It read "no store_id/0 + data_dir/0
    %% on the service module, so hecate_om wires the mesh and starts NO
    %% reckon-db", and on a live island `reckon_db', `reckon_evoq',
    %% `reckon_gater', `evoq', `khepri' and `ra' were all RUNNING applications,
    %% six of thirty-one. The two callbacks never suppressed the applications;
    %% they suppress the STORE. What was true was narrower: no store open, no
    %% data directory, nothing written.
    %%
    %% The store is open now, and it holds the one thing a live simulation
    %% cannot: what a world FOUND, kept after the world it found it in has died.
    {hecate_om, "~> 0.10"}
]}.

{project_plugins, [rebar3_lint]}.

%% The sibling services' block, verbatim. Without it the run ends on one
%% `Unknown function macula:publish/4' forever, because macula arrives
%% transitively through hecate_om and rebar3's default plt holds direct deps
%% only. A gate that is red for a reason nobody can fix is a gate everybody
%% learns to skip, and this one had twenty-three real warnings hiding behind it.
{dialyzer, [
    {warnings, [no_unknown]},
    %% ⚠ COWBOY ARRIVES TRANSITIVELY THROUGH hecate_om, so it is not in the plt
    %% by default and dialyzer cannot see the `cowboy_websocket' behaviour that
    %% `island_socket' implements. A behaviour nobody checks is four callbacks
    %% free to drift from what cowboy actually calls, and they are only called in
    %% production. Naming the two directly rather than widening the plt to every
    %% transitive dep, which would pull in the whole macula and reckon tree for
    %% no gain.
    {plt_extra_apps, [cowboy, ranch]},
    {exclude_apps, [
        macula, macula_envy, macula_mdns,
        reckon_db, reckon_evoq, reckon_gater, evoq,
        khepri, ra, horus, aten, seshat, gen_batch_server,
        gproc, msgpack, jsx
        %% ⚠ cowboy AND ranch ARE DELIBERATELY NOT HERE. Excluding them costs the
        %% callback info for `cowboy_websocket', which `island_socket'
        %% implements, and a behaviour nobody checks is four callbacks that can
        %% silently drift from what cowboy calls. hecate_om's health handler and
        %% the island's page both live behind cowboy too.
    ]}
]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        hecate_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => hecate_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {hecate_biotope, "0.1.0"}, [hecate_biotope, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
